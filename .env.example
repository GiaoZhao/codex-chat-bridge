QQ_APP_ID=
QQ_APP_SECRET=
QQ_BIND_CODE=replace-with-a-random-one-time-code
QQ_ALLOWED_OPENID=
QQ_NOTIFY_ON_READY=0

CODEX_THREAD_ID=00000000-0000-4000-8000-000000000000
CODEX_WORKDIR=/absolute/path/to/your/project
CODEX_COMMAND=codex
# auto: use the shared daemon when available, otherwise use codex exec.
# app-server: require the shared daemon; exec: always use the legacy CLI path.
CODEX_TRANSPORT=auto
CODEX_APP_SERVER_SOCKET=~/.codex/app-server-control/app-server-control.sock
CODEX_SESSIONS_DIR=~/.codex/sessions
CODEX_STATE_DB=~/.codex/state_5.sqlite
# Reserved for a future non-destructive Desktop synchronization API. Keep disabled.
CODEX_DESKTOP_REFRESH=0
CODEX_DESKTOP_CDP_URL=http://127.0.0.1:9229
CODEX_DESKTOP_REFRESH_DELAY_MS=800

QQ_REPLY_MAX_CHARS=1500
QQ_REPLY_MAX_CHUNKS=8
QQ_ATTACHMENT_MAX_BYTES=20971520
QQ_ATTACHMENT_MAX_IMAGES=3
QQ_GATEWAY_INTENTS=100663296
CODEX_TURN_TIMEOUT=7200
CODEX_QUEUE_WAIT_TIMEOUT=21600
